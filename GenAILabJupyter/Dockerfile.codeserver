# VS Code in the browser (code-server) instead of JupyterLab, same lab content.
# Build:  docker build -f Dockerfile.codeserver -t genai-lab-vscode .
# Run:    docker run -p 8080:8080 -e PASSWORD=changeme genai-lab-vscode
#         open http://localhost:8080   (password = PASSWORD)
FROM codercom/code-server:latest

USER root
RUN apt-get update && apt-get install -y --no-install-recommends \
        python3 python3-pip python3-venv git ca-certificates && \
    rm -rf /var/lib/apt/lists/*

# python deps (reuse the same list; JupyterLab lines are harmless here)
COPY requirements.txt /tmp/requirements.txt
RUN pip3 install --no-cache-dir --break-system-packages -r /tmp/requirements.txt

# OSS Python extension from Open VSX (note: Pylance is NOT available on Open VSX)
RUN code-server --install-extension ms-python.python || true

ENV SANDBOX_MODE=mock
WORKDIR /home/coder/work
COPY sandbox.py grader.py grader_tests.py ./
COPY content ./content
COPY RAG_Lab_Participant.ipynb RAG_Lab.ipynb ./
COPY README_IN_LAB.md ./README.md
RUN chown -R coder:coder /home/coder/work

USER coder
EXPOSE 8080
CMD ["code-server", "--bind-addr", "0.0.0.0:8080", "--auth", "password", "/home/coder/work"]
